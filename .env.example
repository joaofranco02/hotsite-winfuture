# ------------------------------------------------------------------
# WIN Future Universitário — variáveis de ambiente
# Copie para `.env.local` e preencha quando as informações existirem.
# Se um valor ficar vazio, o site funciona normalmente e apenas
# desativa o recurso correspondente (nada quebra).
# ------------------------------------------------------------------

# URL canônica do site (usada em metadata/OG). Ex: https://winfuture.com.br
NEXT_PUBLIC_SITE_URL=

# Destino do CTA "GARANTIR MINHA VAGA" (formulário, Sympla, checkout, etc.)
# Enquanto vazio, os botões ficam desativados de forma acessível.
NEXT_PUBLIC_REGISTRATION_URL=

# Analytics — se vazios, nenhum script é carregado.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
